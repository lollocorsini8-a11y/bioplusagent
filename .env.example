# Copia in .env e compila. Senza GROQ_API_KEY l'agente funziona comunque (risposte deterministiche).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Usati solo se avvii il backend FUORI da Docker (in Docker li imposta docker-compose.yml)
DATABASE_URL=postgresql+psycopg://biopulse:biopulse@localhost:5432/biopulse
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=biopulse
POSTGRES_PASSWORD=biopulse
POSTGRES_DB=biopulse
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_SAME_ORIGIN=false

# Alert opzionali (senza credenziali l'invio è simulato e registrato)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CLINICIAN_PHONE=

# Valori demo locali; per produzione usare credenziali dedicate, HTTPS e una build frontend
# con NEXT_PUBLIC_API_URL impostato sull'API pubblica.
APP_ENV=development
DEMO_MODE=true
ALLOW_SELF_REGISTRATION=true
PUBLIC_DEMO_ENABLED=false
COOKIE_SECURE=false
BIOMETRIC_RETENTION_DAYS=365
CLINICAL_RETENTION_DAYS=730
